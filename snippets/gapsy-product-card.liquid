{%- comment -%}
  Product card: image on a light surface, colour swatches (variant images) top-left,
  round "add to cart" button top-right, title + price below.
  Params: product, option_name (default 'Color'), sizes, index (for the varying card heights)
  JS: assets/gapsy-products.js (swatch switch + AJAX add to cart). Without JS the swatch/cart
  controls fall back to the product page / a normal cart form.
{%- endcomment -%}
{%- liquid
  assign opt_name = option_name | default: 'Color' | downcase | replace: 'colour', 'color'
  assign opt_index = -1
  for option in product.options_with_values
    assign this_name = option.name | downcase | replace: 'colour', 'color'
    if this_name == opt_name
      assign opt_index = forloop.index0
    endif
  endfor
  assign current = product.selected_or_first_available_variant
  assign main_image = current.featured_image | default: product.featured_image
  assign sold_out = false
  unless product.available
    assign sold_out = true
  endunless
-%}
<article class="gapsy-card" data-product-card data-variant-id="{{ current.id }}">
  <div class="gapsy-card__media">
    <a href="{{ product.url }}" class="gapsy-card__link" aria-label="{{ product.title | escape }}">
      <span class="gapsy-card__img" data-card-img-wrap>
        {%- if main_image != blank -%}
          {{ main_image | image_url: width: 1200 | image_tag: widths: '360, 540, 720, 960, 1200', sizes: sizes, alt: product.title, class: 'gapsy-card__image' }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'gapsy-placeholder gapsy-card__image' }}
        {%- endif -%}
      </span>
    </a>

    {%- if opt_index >= 0 and product.variants.size > 1 -%}
      {%- assign seen = '' -%}
      <div class="gapsy-card__swatches" role="radiogroup" aria-label="{{ product.options_with_values[opt_index].name | escape }}">
        {%- for variant in product.variants -%}
          {%- assign value = variant.options[opt_index] -%}
          {%- assign key = '|' | append: value | append: '|' -%}
          {%- unless seen contains key -%}
            {%- assign seen = seen | append: key -%}
            {%- assign v_img = variant.featured_image | default: product.featured_image -%}
            <button
              type="button"
              class="gapsy-card__swatch{% if variant.id == current.id %} is-active{% endif %}"
              role="radio"
              aria-checked="{% if variant.id == current.id %}true{% else %}false{% endif %}"
              aria-label="{{ value | escape }}"
              data-swatch
              data-variant="{{ variant.id }}"
              data-available="{{ variant.available }}"
              {% if v_img != blank %}data-src="{{ v_img | image_url: width: 1200 }}" data-srcset="{{ v_img | image_url: width: 540 }} 540w, {{ v_img | image_url: width: 960 }} 960w, {{ v_img | image_url: width: 1200 }} 1200w"{% endif %}
            >
              {%- if v_img != blank -%}
                {{ v_img | image_url: width: 96 | image_tag: alt: '', loading: 'lazy' }}
              {%- else -%}
                <span class="gapsy-card__swatch-color" style="background: {{ value | handleize | replace: '-', '' }};"></span>
              {%- endif -%}
            </button>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <form method="post" action="{{ routes.cart_add_url }}" class="gapsy-card__form" data-card-form>
      <input type="hidden" name="id" value="{{ current.id }}" data-card-id>
      <input type="hidden" name="quantity" value="1">
      <button type="submit" class="gapsy-card__cart" {% if sold_out %}disabled{% endif %} aria-label="{% if sold_out %}Sold out{% else %}Add {{ product.title | escape }} to cart{% endif %}" data-card-cart>
        {%- render 'gapsy-icon', icon: 'cart', class: 'gapsy-card__cart-icon' -%}
        <svg class="gapsy-card__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5 10 17 19 7"/></svg>
      </button>
    </form>
  </div>

  <a href="{{ product.url }}" class="gapsy-card__info">
    <h3 class="gapsy-card__title">{{ product.title }}</h3>
    <p class="gapsy-card__price">
      {%- if product.compare_at_price > product.price -%}<s class="gapsy-card__compare">{{ product.compare_at_price | money }}</s> {% endif -%}
      <span data-card-price>{{ product.price | money }}</span>
    </p>
  </a>
</article>
