{%- comment -%}
  Gapsy · Modern Bags — head include.
  Renders: local @font-face (Anton, Playfair Display Italic, Inter, Alumni Sans, Alumni Sans SC),
  brand CSS variables from Theme settings → "Modern Bags · Brand", and the stylesheets.
  Rendered in layout/theme.liquid right after 'color-palette'.
{%- endcomment -%}
{{ 'gapsy-anton-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'gapsy-alumni-500.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
<style>
  @font-face { font-family: 'Anton'; src: url('{{ 'gapsy-anton-400.woff2' | asset_url }}') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Playfair Display'; src: url('{{ 'gapsy-playfair-400-italic.woff2' | asset_url }}') format('woff2'); font-weight: 400; font-style: italic; font-display: swap; }
  @font-face { font-family: 'Inter'; src: url('{{ 'gapsy-inter-300.woff2' | asset_url }}') format('woff2'); font-weight: 300; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Inter'; src: url('{{ 'gapsy-inter-400.woff2' | asset_url }}') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Inter'; src: url('{{ 'gapsy-inter-500.woff2' | asset_url }}') format('woff2'); font-weight: 500; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Alumni Sans'; src: url('{{ 'gapsy-alumni-400.woff2' | asset_url }}') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Alumni Sans'; src: url('{{ 'gapsy-alumni-500.woff2' | asset_url }}') format('woff2'); font-weight: 500; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Alumni Sans'; src: url('{{ 'gapsy-alumni-600.woff2' | asset_url }}') format('woff2'); font-weight: 600; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Alumni Sans'; src: url('{{ 'gapsy-alumni-700.woff2' | asset_url }}') format('woff2'); font-weight: 700; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Alumni Sans SC'; src: url('{{ 'gapsy-alumni-sc-600.woff2' | asset_url }}') format('woff2'); font-weight: 600; font-style: normal; font-display: swap; }

  :root {
    --gapsy-black: {{ settings.gapsy_color_black | default: '#000000' }};
    --gapsy-white: {{ settings.gapsy_color_white | default: '#ffffff' }};
    --gapsy-primary: {{ settings.gapsy_color_primary | default: '#db2128' }};
    --gapsy-grey-100: {{ settings.gapsy_color_text | default: '#212528' }};
    --gapsy-grey-80: {{ settings.gapsy_color_text_muted | default: '#343a3f' }};
    --gapsy-surface: {{ settings.gapsy_color_surface | default: '#e9e9e9' }};
    --gapsy-grad-from: {{ settings.gapsy_gradient_from | default: '#e3262b' }};
    --gapsy-grad-to: {{ settings.gapsy_gradient_to | default: '#ffb562' }};
    --gapsy-text-grad-from: {{ settings.gapsy_text_gradient_from | default: '#ffdd89' }};
    --gapsy-text-grad-to: {{ settings.gapsy_text_gradient_to | default: '#ff7368' }};
    --gapsy-gradient: linear-gradient(90deg, var(--gapsy-grad-from) 0%, var(--gapsy-grad-to) 100%);
    --gapsy-text-gradient: linear-gradient(180deg, var(--gapsy-text-grad-from) 0%, var(--gapsy-text-grad-to) 100%);
  }
</style>
