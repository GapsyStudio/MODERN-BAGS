{%- comment -%}
  Responsive image or a neutral placeholder when nothing is picked in the editor.
  Params: image, sizes (default 50vw), class, loading ('lazy' | 'eager'), alt, alt_fallback, placeholder ('image' | 'product-1' …)
{%- endcomment -%}
{%- liquid
  assign img_sizes = sizes | default: '(min-width: 992px) 50vw, 100vw'
  assign img_loading = loading | default: 'lazy'
  # editor alt first; images without one get a neutral description (no empty alt)
  assign img_alt = alt | default: image.alt | default: alt_fallback | default: 'Model with a Modern Bags handbag' | escape
-%}
{%- if image != blank -%}
  {%- if img_loading == 'eager' -%}
    {{ image | image_url: width: 2400 | image_tag: widths: '360, 540, 720, 960, 1200, 1600, 2000, 2400', sizes: img_sizes, class: class, alt: img_alt, loading: 'eager', fetchpriority: 'high' }}
  {%- else -%}
    {{ image | image_url: width: 2400 | image_tag: widths: '360, 540, 720, 960, 1200, 1600, 2000, 2400', sizes: img_sizes, class: class, alt: img_alt, loading: 'lazy' }}
  {%- endif -%}
{%- else -%}
  {%- assign ph_class = 'gapsy-placeholder ' | append: class -%}
  {{ placeholder | default: 'image' | placeholder_svg_tag: ph_class }}
{%- endif -%}
