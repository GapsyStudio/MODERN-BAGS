{%- comment -%}
  Gapsy icons. Usage: {% render 'gapsy-icon', icon: 'arrow', class: 'gapsy-link__icon' %}
  icons: arrow (lucide arrow-up-right), cart (akar cart), menu, close
{%- endcomment -%}
{%- case icon -%}
  {%- when 'arrow' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke | default: 1.5 }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
  {%- when 'cart' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 7h13.79a1 1 0 0 1 .97 1.24l-1.5 6A1 1 0 0 1 17.29 15H8.72a1 1 0 0 1-.99-.83L5.84 3.83A1 1 0 0 0 4.85 3H3"/><path d="M8 15 7.5 18H18"/><circle cx="9" cy="21" r="0.9"/><circle cx="17" cy="21" r="0.9"/></svg>
  {%- when 'menu' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M3 8h18"/><path d="M3 16h18"/></svg>
  {%- when 'close' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M5 5l14 14"/><path d="M19 5 5 19"/></svg>
{%- endcase -%}
