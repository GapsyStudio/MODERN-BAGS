{%- comment -%}
  Gapsy · Collection page (templates/collection.json) — also used for /collections/all.
  Heading: italic prefix + collection title (Anton). Category links from a menu (default "shop-categories",
  falls back to the 3 bag collections), sort select, product grid with the same cards as the home page,
  pagination. JS: assets/gapsy-pages.js ('collection').
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign nav = s.category_menu
  if nav == blank and s.category_menu_handle != blank
    assign nav = linklists[s.category_menu_handle]
  endif
  assign per_page = s.per_page
  assign sort_by = collection.sort_by | default: collection.default_sort_by
-%}
<section
  class="gapsy-section gapsy-collection gapsy-pad"
  data-gapsy-section="collection"
  style="--gapsy-pt: {{ s.padding_top | divided_by: 16.0 }}rem; --gapsy-pb: {{ s.padding_bottom | divided_by: 16.0 }}rem; --card-h: {{ s.card_height | divided_by: 16.0 }}rem; --card-bg: {{ s.card_background }};"
>
  <div class="gapsy-container">
    {%- capture heading -%}{% if s.heading_prefix != blank %}<em>{{ s.heading_prefix }}</em> {% endif %}{{ collection.title }}{%- endcapture -%}
    {%- render 'gapsy-heading', text: heading, size: s.heading_size, em_size: s.em_size, size_mobile: s.heading_size_mobile, tag: 'h1' -%}

    {%- if s.show_description and collection.description != blank -%}
      <div class="gapsy-collection__desc gapsy-rte" data-collection-fade>{{ collection.description }}</div>
    {%- endif -%}

    <div class="gapsy-collection__bar" data-collection-fade>
      <nav class="gapsy-collection__cats" aria-label="Categories">
        <a href="{{ routes.all_products_collection_url }}" class="gapsy-collection__cat{% if collection.handle == 'all' %} is-active{% endif %}">{{ s.all_label }}</a>
        {%- if nav.links.size > 0 -%}
          {%- for link in nav.links -%}
            <a href="{{ link.url }}" class="gapsy-collection__cat{% if link.active or link.object.handle == collection.handle %} is-active{% endif %}">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          {%- assign handles = 'everyday-bags,statement-bags,mini-bags' | split: ',' -%}
          {%- for h in handles -%}
            {%- assign c = collections[h] -%}
            {%- if c != blank -%}<a href="{{ c.url }}" class="gapsy-collection__cat{% if c.handle == collection.handle %} is-active{% endif %}">{{ c.title }}</a>{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </nav>
      {%- if s.show_sort -%}
        <label class="gapsy-collection__sort">
          <span class="gapsy-visually-hidden">Sort by</span>
          <select data-collection-sort>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </label>
      {%- endif -%}
    </div>

    {%- paginate collection.products by per_page -%}
      {%- if collection.products.size > 0 -%}
        <ul class="gapsy-collection__grid" role="list">
          {%- for product in collection.products -%}
            <li class="gapsy-collection__item" data-product-item>
              {%- render 'gapsy-product-card', product: product, option_name: s.option_name, sizes: '(min-width: 992px) 31vw, 50vw' -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="gapsy-collection__empty" data-collection-fade>
          <p>{{ s.empty_text }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="gapsy-link"><span class="gapsy-link__label">{{ s.all_label }}</span>{%- render 'gapsy-icon', icon: 'arrow', class: 'gapsy-link__icon' -%}</a>
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="gapsy-pagination" aria-label="Pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Previous page">←</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- elsif part.title == paginate.current_page -%}<span class="is-current" aria-current="page">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Next page">→</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% stylesheet %}
  .gapsy-collection__desc { max-width: 40rem; margin-top: 0.5rem; }
  .gapsy-collection__bar { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-top: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid rgba(0, 0, 0, 0.12); }
  .gapsy-collection__cats { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .gapsy-collection__cat { display: inline-flex; align-items: center; min-height: 3rem; padding: 0 1.25rem; border: 1px solid rgba(0, 0, 0, 0.2); border-radius: 999px; font-family: var(--gapsy-font-condensed); font-weight: 600; font-size: 1.5rem; line-height: 1; text-transform: uppercase; transition: background 0.3s, color 0.3s, border-color 0.3s; }
  .gapsy-collection__cat:hover { border-color: var(--gapsy-black); }
  .gapsy-collection__cat.is-active { background: var(--gapsy-black); color: var(--gapsy-white); border-color: var(--gapsy-black); }
  .gapsy-collection__sort { position: relative; display: inline-flex; align-items: center; align-self: flex-start; }
  .gapsy-section .gapsy-collection__sort select { height: 3rem; padding: 0 2.5rem 0 1.25rem; border: 1px solid rgba(0, 0, 0, 0.2); border-radius: 999px; background: transparent; box-shadow: none; color: inherit; font: 600 1.375rem/1 var(--gapsy-font-condensed); text-transform: uppercase; cursor: pointer; -webkit-appearance: none; appearance: none; }
  .gapsy-collection__sort svg { position: absolute; right: 1rem; width: 1rem; height: 1rem; pointer-events: none; }
  .gapsy-collection__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3rem 1.25rem; margin-top: 2.5rem; }
  .gapsy-collection__empty { display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem; padding: 4rem 0; font-size: 1.25rem; }
  @media (max-width: 991px) {
    .gapsy-collection__bar { flex-direction: column; align-items: stretch; }
    .gapsy-collection__cats { flex-wrap: nowrap; overflow-x: auto; margin-inline: calc(-1 * var(--gapsy-gutter)); padding-inline: var(--gapsy-gutter); scrollbar-width: none; }
    .gapsy-collection__cats::-webkit-scrollbar { display: none; }
    .gapsy-collection__cat { flex: none; font-size: 1.25rem; min-height: 2.5rem; }
    .gapsy-collection__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 0.75rem; }
    .gapsy-collection { --card-h: 48vw; }
    .gapsy-section.gapsy-collection .gapsy-card__title, .gapsy-collection .gapsy-card__price { font-size: 1.25rem; }
    .gapsy-collection .gapsy-card__info { flex-direction: column; gap: 0.125rem; }
    .gapsy-collection .gapsy-card__cart { width: 2.75rem; height: 2.75rem; }
    .gapsy-collection .gapsy-card__swatch { width: 1.75rem; height: 1.75rem; padding: 0.2rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gapsy · Collection",
  "tag": "div",
  "class": "gapsy-section-wrap",
  "settings": [
    { "type": "text", "id": "heading_prefix", "label": "Italic word before the title", "default": "shop" },
    { "type": "range", "id": "heading_size", "label": "Heading size (px @1440)", "min": 40, "max": 200, "step": 2, "default": 110 },
    { "type": "range", "id": "em_size", "label": "Italic word size (px @1440)", "min": 20, "max": 140, "step": 2, "default": 64 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, mobile (px)", "min": 28, "max": 100, "step": 2, "default": 52 },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    { "type": "header", "content": "Categories & sorting" },
    { "type": "link_list", "id": "category_menu", "label": "Category links menu" },
    { "type": "text", "id": "category_menu_handle", "label": "Menu handle (fallback)", "default": "shop-categories", "info": "Empty menu = Everyday / Statement / Mini bags." },
    { "type": "text", "id": "all_label", "label": "\"All\" label", "default": "All bags" },
    { "type": "checkbox", "id": "show_sort", "label": "Show sorting", "default": true },
    { "type": "header", "content": "Grid" },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 6, "max": 36, "step": 3, "default": 12 },
    { "type": "range", "id": "card_height", "label": "Card photo height (px @1440)", "min": 240, "max": 700, "step": 5, "default": 440 },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ebebeb" },
    { "type": "text", "id": "option_name", "label": "Swatch option name", "default": "Color" },
    { "type": "text", "id": "empty_text", "label": "Empty collection text", "default": "No bags here yet — check back soon." },
    { "type": "range", "id": "padding_top", "label": "Top padding (px @1440)", "min": 0, "max": 200, "step": 4, "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (px @1440)", "min": 0, "max": 200, "step": 4, "default": 100 }
  ]
}
{% endschema %}
