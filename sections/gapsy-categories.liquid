{%- comment -%}
  Gapsy · Bag categories — "discover BAG CATEGORIES" + rounded "pill" cards linked to collections.
  Data: blocks "Category" → a collection (title, URL and image come from it; each can be overridden),
  bottom text + "Learn more" link.
  JS: assets/gapsy-categories.js — heading letters, cards rise in a stagger, photos settle from zoom.
  Mobile: cards become a horizontal swipe row with scroll-snap.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section
  class="gapsy-section gapsy-cats gapsy-pad"
  data-gapsy-section="categories"
  {% if s.anchor_id != blank %}id="{{ s.anchor_id | handleize }}"{% endif %}
  style="--gapsy-pt: {{ s.padding_top | divided_by: 16.0 }}rem; --gapsy-pb: {{ s.padding_bottom | divided_by: 16.0 }}rem; --cats-gap: {{ s.heading_gap | divided_by: 16.0 }}rem; --card-h: {{ s.card_height | divided_by: 16.0 }}rem; --card-bg: {{ s.card_background }}; background: {{ s.background }}; color: {{ s.text_color }};"
>
  <div class="gapsy-container">
    {%- render 'gapsy-heading', text: s.heading, size: s.heading_size, em_size: s.em_size, size_mobile: s.heading_size_mobile -%}

    <ul class="gapsy-cats__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign col = b.collection
          if col == blank and b.collection_handle != blank
            assign col = collections[b.collection_handle]
          endif
          assign title = b.title | default: col.title | default: 'Collection'
          assign url = b.link | default: col.url | default: routes.collections_url
          assign img = b.image | default: col.featured_image
        -%}
        <li class="gapsy-cats__item" data-cats-item {{ block.shopify_attributes }}>
          <a href="{{ url }}" class="gapsy-cats__card" data-cursor="{{ settings.gapsy_cursor_label_category | default: 'Shop' | escape }}">
            <span class="gapsy-cats__pill" data-cats-pill>
              <span class="gapsy-cats__img" style="--img-y: {{ b.image_offset }}%; --img-scale: {{ b.image_scale | divided_by: 100.0 }};" data-cats-img>
                {%- render 'gapsy-image', image: img, sizes: '(min-width: 992px) 31vw, 72vw', alt: title -%}
              </span>
            </span>
            <span class="gapsy-cats__name">
              <span>{{ title }}</span>
              {%- render 'gapsy-icon', icon: 'arrow', class: 'gapsy-cats__arrow' -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if s.text != blank or s.link_label != blank -%}
      <div class="gapsy-cats__foot" data-cats-foot>
        {%- if s.text != blank -%}<div class="gapsy-cats__text">{{ s.text }}</div>{%- endif -%}
        {%- if s.link_label != blank -%}
          <a href="{{ s.link_url | default: routes.collections_url }}" class="gapsy-link" data-magnetic="0.2">
            <span class="gapsy-link__label">{{ s.link_label }}</span>
            {%- render 'gapsy-icon', icon: 'arrow', class: 'gapsy-link__icon' -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .gapsy-cats__list { display: grid; grid-template-columns: repeat(var(--cats-cols, 3), 1fr); gap: 1.25rem; margin-top: var(--cats-gap, 2.75rem); }
  .gapsy-cats__card { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }
  .gapsy-cats__pill { position: relative; display: block; width: 100%; height: var(--card-h, 36.25rem); border-radius: 999px; overflow: hidden; background: var(--card-bg, #d6d6d6); isolation: isolate; }
  .gapsy-cats__img { position: absolute; inset: 0; display: block; }
  .gapsy-cats__img img, .gapsy-cats__img svg { width: 100%; height: 100%; object-fit: cover; object-position: 50% var(--img-y, 0%); transform: scale(var(--img-scale, 1)); transition: transform 1.1s var(--gapsy-ease); }
  .gapsy-cats__name { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--gapsy-font-condensed); font-weight: 600; font-size: 2.5rem; line-height: 1.1; text-transform: uppercase; }
  .gapsy-cats__arrow { width: 2.25rem; height: 2.25rem; transition: transform 0.5s var(--gapsy-ease); }
  @media (hover: hover) {
    .gapsy-cats__card:hover .gapsy-cats__img img { transform: scale(calc(var(--img-scale, 1) * 1.06)); }
    .gapsy-cats__card:hover .gapsy-cats__arrow { transform: rotate(45deg); }
  }
  .gapsy-cats__foot { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-top: 3.875rem; }
  .gapsy-cats__text { max-width: 40rem; font-size: 1.1875rem; line-height: 1.55; color: var(--gapsy-grey-80); }
  .gapsy-cats__text p { margin: 0; }
  @media (max-width: 991px) {
    .gapsy-cats__list { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 0.75rem; margin-inline: calc(-1 * var(--gapsy-gutter)); padding-inline: var(--gapsy-gutter); scrollbar-width: none; margin-top: 2rem; }
    .gapsy-cats__list::-webkit-scrollbar { display: none; }
    .gapsy-cats__item { flex: 0 0 68vw; scroll-snap-align: start; scroll-margin-left: var(--gapsy-gutter); }
    .gapsy-cats__pill { height: auto; aspect-ratio: 440 / 580; }
    .gapsy-cats__name { font-size: 1.75rem; }
    .gapsy-cats__arrow { width: 1.5rem; height: 1.5rem; }
    .gapsy-cats__foot { flex-direction: column; align-items: flex-start; margin-top: 2rem; }
    .gapsy-cats__text { font-size: 1rem; }
  }
  @media (min-width: 768px) and (max-width: 991px) { .gapsy-cats__item { flex-basis: 40vw; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Gapsy · Categories",
  "tag": "div",
  "class": "gapsy-section-wrap",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "<em>discover</em> Bag categories" },
    { "type": "range", "id": "heading_size", "label": "Heading size (px @1440)", "min": 40, "max": 200, "step": 2, "default": 110 },
    { "type": "range", "id": "em_size", "label": "Italic words size (px @1440)", "min": 20, "max": 140, "step": 2, "default": 64 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, mobile (px)", "min": 28, "max": 100, "step": 2, "default": 52 },
    { "type": "range", "id": "heading_gap", "label": "Space under heading (px @1440)", "min": 0, "max": 160, "step": 2, "default": 44 },
    { "type": "range", "id": "card_height", "label": "Card height (px @1440)", "min": 300, "max": 800, "step": 10, "default": 580 },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#d6d6d6" },
    { "type": "richtext", "id": "text", "label": "Bottom text", "default": "<p>Discover statement pieces and timeless everyday bags.<br>Find the style that fits your look.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Learn more" },
    { "type": "url", "id": "link_url", "label": "Link", "info": "Empty = all collections." },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "range", "id": "padding_top", "label": "Top padding (px @1440)", "min": 0, "max": 200, "step": 4, "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (px @1440)", "min": 0, "max": 200, "step": 4, "default": 48 },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "categories" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "collection_handle", "label": "Collection handle (fallback)", "info": "Used when no collection is picked, e.g. everyday-bags." },
        { "type": "text", "id": "title", "label": "Title", "info": "Empty = collection title." },
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Empty = collection image. Best: model photo on a transparent or light grey background, 3:4." },
        { "type": "range", "id": "image_offset", "label": "Photo vertical position (%)", "min": 0, "max": 100, "step": 5, "default": 0 },
        { "type": "range", "id": "image_scale", "label": "Photo zoom (%)", "min": 100, "max": 150, "step": 5, "default": 100 },
        { "type": "url", "id": "link", "label": "Custom link", "info": "Empty = collection page." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Gapsy · Categories",
      "blocks": [
        { "type": "category", "settings": { "collection_handle": "everyday-bags", "title": "Everyday bags" } },
        { "type": "category", "settings": { "collection_handle": "statement-bags", "title": "Statement bags" } },
        { "type": "category", "settings": { "collection_handle": "mini-bags", "title": "Mini bags" } }
      ]
    }
  ]
}
{% endschema %}
