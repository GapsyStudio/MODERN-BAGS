{%- comment -%}
  Gapsy · Best products — "our BEST products" + product cards from a collection.
  Data: collection picker (or handle fallback), number of products, three card heights that repeat
  (staggered rhythm like the design), colour option name for swatches, "View more" link.
  JS: assets/gapsy-products.js — cards rise with different speeds; swatches switch the photo and the
  variant; the round button adds to cart via AJAX and updates "Cart (n)".
  Mobile: horizontal swipe row.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign col = s.collection
  if col == blank and s.collection_handle != blank
    assign col = collections[s.collection_handle]
  endif
  assign limit = s.limit
-%}
<section
  class="gapsy-section gapsy-products gapsy-pad"
  data-gapsy-section="products"
  {% if s.anchor_id != blank %}id="{{ s.anchor_id | handleize }}"{% endif %}
  style="--gapsy-pt: {{ s.padding_top | divided_by: 16.0 }}rem; --gapsy-pb: {{ s.padding_bottom | divided_by: 16.0 }}rem; --prod-gap: {{ s.heading_gap | divided_by: 16.0 }}rem; --h1: {{ s.height_1 | divided_by: 16.0 }}rem; --h2: {{ s.height_2 | divided_by: 16.0 }}rem; --h3: {{ s.height_3 | divided_by: 16.0 }}rem; --card-bg: {{ s.card_background }}; background: {{ s.background }}; color: {{ s.text_color }};"
>
  <div class="gapsy-container">
    {%- render 'gapsy-heading', text: s.heading, size: s.heading_size, em_size: s.em_size, size_mobile: s.heading_size_mobile -%}

    <ul class="gapsy-products__grid" role="list">
      {%- if col != blank and col.products_count > 0 -%}
        {%- for product in col.products limit: limit -%}
          <li class="gapsy-products__item" data-product-item>
            {%- render 'gapsy-product-card', product: product, option_name: s.option_name, sizes: '(min-width: 992px) 31vw, 72vw' -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <li class="gapsy-products__item" data-product-item>
            <article class="gapsy-card">
              <div class="gapsy-card__media"><span class="gapsy-card__img">{{ 'product-' | append: i | placeholder_svg_tag: 'gapsy-placeholder gapsy-card__image' }}</span></div>
              <div class="gapsy-card__info"><h3 class="gapsy-card__title">Pick a collection</h3><p class="gapsy-card__price">{{ 7850 | money }}</p></div>
            </article>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if s.link_label != blank -%}
      <div class="gapsy-products__more" data-products-more>
        <a href="{{ s.link_url | default: col.url | default: routes.all_products_collection_url }}" class="gapsy-link" data-magnetic="0.2">
          <span class="gapsy-link__label">{{ s.link_label }}</span>
          {%- render 'gapsy-icon', icon: 'arrow', class: 'gapsy-link__icon' -%}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .gapsy-products__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3rem 1.25rem; align-items: start; margin-top: var(--prod-gap, 2.5rem); }
  .gapsy-products__item:nth-child(3n + 1) { --card-h: var(--h1, 27.1875rem); }
  .gapsy-products__item:nth-child(3n + 2) { --card-h: var(--h2, 20rem); }
  .gapsy-products__item:nth-child(3n + 3) { --card-h: var(--h3, 30.75rem); }
  .gapsy-products__more { display: flex; justify-content: center; margin-top: 4.9rem; }

  @media (max-width: 991px) {
    .gapsy-products__grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 0.75rem; margin-inline: calc(-1 * var(--gapsy-gutter)); padding-inline: var(--gapsy-gutter); scrollbar-width: none; margin-top: 2rem; }
    .gapsy-products__grid::-webkit-scrollbar { display: none; }
    .gapsy-products__item { flex: 0 0 72vw; scroll-snap-align: start; scroll-margin-left: var(--gapsy-gutter); }
    .gapsy-products__item:nth-child(n) { --card-h: 92vw; }
    .gapsy-products__more { margin-top: 2.5rem; }
  }
  @media (min-width: 768px) and (max-width: 991px) { .gapsy-products__item { flex-basis: 42vw; } .gapsy-products__item:nth-child(n) { --card-h: 54vw; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Gapsy · Products",
  "tag": "div",
  "class": "gapsy-section-wrap",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "<em>our</em> Best <em>products</em>" },
    { "type": "range", "id": "heading_size", "label": "Heading size (px @1440)", "min": 40, "max": 200, "step": 2, "default": 110 },
    { "type": "range", "id": "em_size", "label": "Italic words size (px @1440)", "min": 20, "max": 140, "step": 2, "default": 64 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, mobile (px)", "min": 28, "max": 100, "step": 2, "default": 56 },
    { "type": "range", "id": "heading_gap", "label": "Space under heading (px @1440)", "min": 0, "max": 160, "step": 2, "default": 40 },
    { "type": "header", "content": "Products" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "collection_handle", "label": "Collection handle (fallback)", "default": "best-sellers" },
    { "type": "range", "id": "limit", "label": "Number of products", "min": 3, "max": 12, "step": 3, "default": 3 },
    { "type": "text", "id": "option_name", "label": "Swatch option name", "default": "Color", "info": "Product option shown as round swatches. Each colour uses its variant image." },
    { "type": "header", "content": "Cards" },
    { "type": "range", "id": "height_1", "label": "Card 1 photo height (px @1440)", "min": 240, "max": 700, "step": 5, "default": 435 },
    { "type": "range", "id": "height_2", "label": "Card 2 photo height (px @1440)", "min": 240, "max": 700, "step": 5, "default": 320 },
    { "type": "range", "id": "height_3", "label": "Card 3 photo height (px @1440)", "min": 240, "max": 700, "step": 5, "default": 490 },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ebebeb" },
    { "type": "header", "content": "Link" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View more" },
    { "type": "url", "id": "link_url", "label": "Link", "info": "Empty = the collection page." },
    { "type": "header", "content": "Section" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "range", "id": "padding_top", "label": "Top padding (px @1440)", "min": 0, "max": 200, "step": 4, "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (px @1440)", "min": 0, "max": 200, "step": 4, "default": 76 },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "bestsellers" }
  ],
  "presets": [{ "name": "Gapsy · Products" }]
}
{% endschema %}
